# Copy to .env and change every secret before production.
# Never commit .env (listed in .gitignore).

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Prefer the low-privilege app account (see docs/mysql_app_user.sql).
MYSQL_USER=healthing_app
MYSQL_PASSWORD=change-me-strong-password
MYSQL_DATABASE=healthing
SECRET_KEY=change-me-to-a-long-random-string
